{
	# Request errors can otherwise contain custom X-Device-* credentials.
	log default {
		exclude http.log.error http.log.access
	}
	servers {
		protocols h1 h2
		max_header_size 32KB
		timeouts {
			read_header 10s
			read_body 30s
			idle 60s
		}
	}
}

(gateway) {
	reverse_proxy 127.0.0.1:8000 {
		transport http {
			dial_timeout 3s
			response_header_timeout 30s
			# Uvicorn closes idle upstream connections after five seconds.
			keepalive 4s
		}
	}
}

api.zovoeh.cn {
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Cache-Control no-store
	}
	request_body {
		max_size 262144
	}

	@client_get {
		method GET
		path /health/live /v1/config /v1/models /v1/devices /v1/sync/pull
	}
	@client_post {
		method POST
		path /v1/auth/login /v1/auth/refresh /v1/auth/logout /v1/sync/push /v1/analyses
	}
	@analysis_get {
		method GET
		path_regexp analysis "^/v1/analyses/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}(/evidence)?$"
	}
	@history_get {
		method GET
		path_regexp history "^/v1/memories/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/history$"
	}
	@device_delete {
		method DELETE
		path_regexp device "^/v1/devices/[a-zA-Z0-9_-]{1,100}$"
	}
	handle @client_get {
		import gateway
	}
	handle @client_post {
		import gateway
	}
	handle @analysis_get {
		import gateway
	}
	handle @history_get {
		import gateway
	}
	handle @device_delete {
		import gateway
	}
	handle {
		respond "Not found" 404
	}
}
